# Copy to backend/.env and fill in. Never commit the filled-in file.
#
# config/settings.py raises at import if any required variable is missing, so a
# misconfigured deployment fails at startup rather than on the first request.

# --- providers (secrets) --------------------------------------------------
DASHSCOPE_API_KEY=
# Only needed for WEB_SEARCH_PROVIDER=serper; the default ddgs uses no key.
SERPER_API_KEY=

# --- providers (required) -------------------------------------------------
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- model selection (required) -------------------------------------------
CHAT_MODEL=qwen-max
CHAT_MODEL_TURBO=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank

# --- datastores (required) ------------------------------------------------
# host.docker.internal resolves inside a container; use localhost on the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visionagent
ES_URL=http://localhost:9200
ES_PORT=9200
ELASTIC_PASSWORD=

# --- runtime state (optional) ---------------------------------------------
# Everything the application writes lives under one root. The default is
# backend/var, outside the import package.
#   <STATE_DIR>/uploads   user files and session context
#   <STATE_DIR>/graph     graph_*.graphml, vdb_*.json
# STATE_DIR=
# STORAGE_DIR=            # override just the uploads subdirectory
# GRAPH_DIR=              # override just the graph subdirectory

# --- retrieval tuning (optional; defaults shown) --------------------------
# RETRIEVAL_TOP_K=5            # chunks fetched per tool, before reranking
# RERANK_TOP_N=5               # chunks kept after reranking, fed to the prompt
# VECTOR_SIMILARITY_WEIGHT=0.6 # vector vs BM25 balance; 0 keyword, 1 vector
# WEB_SEARCH_RESULTS=10        # hits requested from the search provider
# WEB_SEARCH_TOP_K=3           # web snippets kept after re-ranking

# --- agent tuning (optional; defaults shown) ------------------------------
# MAX_ROUNDS=2                 # retrieval rounds per turn, counting the first
# SUFFICIENT_THRESHOLD=0.5     # reflect when the evaluator scores at or below
# TOOL_TIMEOUT_S=120           # per-tool budget; gather waits for the slowest
# PARSE_TIMEOUT_S=1800         # per-document parse budget in the ingest worker
# MAX_UPLOAD_FILES=10          # files accepted in one multipart request
# MAX_UPLOAD_BYTES=524288000   # maximum bytes in any one file (500 MiB)
# MAX_UPLOAD_TOTAL_BYTES=524288000 # aggregate file bytes per request (500 MiB)
# MAX_CONCURRENT_UPLOADS=2     # admitted upload bodies per API worker
# MAX_UPLOAD_WORKERS=2         # durable ingest children per runtime node
# MAX_UPLOAD_ATTEMPTS=3        # worker incarnations before terminal failure
# UPLOAD_RETRY_BACKOFF_S=5     # exponential retry base delay

# --- component selection (optional; defaults shown) -----------------------
# Each slot picks its implementation here. See docs/architecture.md.
# LLM_PROVIDER=dashscope       # dashscope | claude-cli
#
# claude-cli is a local development/evaluation transport. It uses the CLI's
# existing authentication and supplies LLM calls only, so retrieval still
# needs a configured embedding provider. Verify its isolation after CLI
# upgrades with: python backend/scripts/check_claude_cli.py
# EMBEDDING_PROVIDER=online    # online | offline
# RERANK_PROVIDER=dashscope
# WEB_SEARCH_PROVIDER=ddgs     # ddgs | serper  (ddgs needs no API key)
# PARSER=deepdoc               # deepdoc | vlm
# ANALYZER=ragflow
# CHUNKSTORE=elasticsearch
# INTENT_PARSER=llm            # llm | keywords (keywords makes no LLM call)
# PLANNER=rule_based
# EVALUATOR=llm
# ANSWER=cited

# --- graphrag tuning (optional; defaults shown) ---------------------------
# Separate from EMBEDDING_DIM on purpose: every existing vdb_*.json is written
# at this width. Changing the width requires migrate_graph_embeddings.py;
# changing provider/model at the same width requires that script with --force.
# GRAPH_EMBEDDING_DIM=1024
# GRAPH_ENTITY_TOP_K=5
# GRAPH_RELATION_TOP_K=5

# Stable and unique per runtime node; scopes safe upload-worker PID signals.
# If unset, Traceable RAG derives one from the host and machine boot identity.
# VISIONAGENT_NODE_ID=

# --- vendored RAGFlow (optional) ------------------------------------------
# Overrides where deepdoc looks for its ONNX models and conf/mapping.json.
# Leave unset: it resolves from __file__ inside vendor/ragflow.
# RAG_PROJECT_BASE=

# --- docker compose -------------------------------------------------------
COMPOSE_PROJECT_NAME=visionagent
STACK_VERSION=8.11.3
MEM_LIMIT=1073741824
TIMEZONE=America/Chicago
